{
  "_comment": "Single source of truth for both LDAP integration fixtures. Each user/group is tagged with the backends it should land on. Render with _test/fixtures/regenerate.sh — do not edit the generated bootstrap.ldif or provision-data.sh by hand.",

  "domains": {
    "openldap": {
      "base":       "dc=example,dc=org",
      "people_ou":  "ou=People,dc=example,dc=org",
      "groups_ou":  "ou=Groups,dc=example,dc=org"
    },
    "samba": {
      "base":      "DC=example,DC=local",
      "users_dn":  "CN=Users,DC=example,DC=local",
      "ldb_path":  "/var/lib/samba/private/sam.ldb"
    }
  },

  "password_policy": {
    "max_pwd_age_days": 42,
    "applies_to": ["samba"]
  },

  "groups": [
    { "name": "devs",         "backends": ["openldap"], "gid": 5001 },
    { "name": "ops",          "backends": ["openldap"], "gid": 5002 },
    { "name": "admins",       "backends": ["openldap"], "gid": 5003 },

    { "name": "alpha",        "backends": ["samba"] },
    { "name": "beta",         "backends": ["samba"], "memberGroups": ["Gamma Nested"] },
    { "name": "Gamma Nested", "backends": ["samba"] }
  ],

  "users": [
    {
      "uid":      "alice",
      "backends": ["openldap"],
      "givenName": "Alice", "sn": "Example", "cn": "Alice Example",
      "mail":      "alice@example.org",
      "password":  "password",
      "uidNumber": 1001, "gidNumber": 5001,
      "homeDirectory": "/home/alice",
      "memberOf":  ["devs", "admins"]
    },
    {
      "uid":      "bob",
      "backends": ["openldap"],
      "givenName": "Bob", "sn": "Example", "cn": "Bob Example",
