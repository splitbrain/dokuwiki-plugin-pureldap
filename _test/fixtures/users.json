    "_comment":         "Bulk filler users so count assertions pass: Domain Users > 250, alpha in [20,150). First 28 go into alpha; rest are unaffiliated.",
    "count":            260,
    "uid_format":       "p.user%03d",
    "givenName_format": "P%d",
    "sn":               "User",
    "password":         "Foo_b_ar123!",
    "memberships":      [
      { "group": "alpha", "first_n": 28 }
    ]
  }
