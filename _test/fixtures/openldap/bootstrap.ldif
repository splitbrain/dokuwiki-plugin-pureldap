# Sample posixAccount users + posixGroup groups for LDAPClient integration
# tests. Loaded automatically by the osixia/openldap entrypoint.

dn: ou=People,dc=example,dc=org
objectClass: organizationalUnit
ou: People

dn: ou=Groups,dc=example,dc=org
objectClass: organizationalUnit
ou: Groups

dn: uid=alice,ou=People,dc=example,dc=org
objectClass: inetOrgPerson
objectClass: posixAccount
uid: alice
cn: Alice Example
sn: Example
mail: alice@example.org
uidNumber: 1001
gidNumber: 5001
homeDirectory: /home/alice
userPassword: {SSHA}5en6G6MezRroT3XKqkdPOmY/BfQ=

dn: uid=bob,ou=People,dc=example,dc=org
objectClass: inetOrgPerson
objectClass: posixAccount
uid: bob
cn: Bob Example
sn: Example
mail: bob@example.org
uidNumber: 1002
gidNumber: 5002
homeDirectory: /home/bob
userPassword: {SSHA}5en6G6MezRroT3XKqkdPOmY/BfQ=

dn: cn=devs,ou=Groups,dc=example,dc=org
objectClass: posixGroup
cn: devs
gidNumber: 5001
memberUid: alice
memberUid: bob

dn: cn=ops,ou=Groups,dc=example,dc=org
objectClass: posixGroup
cn: ops
gidNumber: 5002
memberUid: bob

dn: cn=admins,ou=Groups,dc=example,dc=org
objectClass: posixGroup
cn: admins
gidNumber: 5003
memberUid: alice
