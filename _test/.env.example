# Copy to _test/.env and adjust if you're not using the bundled
# docker-compose fixture. Real environment variables always take
# precedence over values defined here, so CI is unaffected.
#
# Bring up the fixtures with:
#   docker compose -f _test/docker-compose.yml up -d --wait

# OpenLDAP backend (LDAPClientTest, plus LDAPTestCase subclasses
# that point HOST_ENV at LDAP_TEST_HOST).
LDAP_TEST_HOST=localhost
LDAP_TEST_PORT=1389
LDAP_TEST_PORT_SSL=1636

# Samba AD-DC backend (ADClientTest, AuthTest, GroupHierarchyCacheTest).
AD_TEST_HOST=localhost
AD_TEST_PORT=7389
AD_TEST_PORT_SSL=7636
